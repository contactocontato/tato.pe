{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tato-pe",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  // Conserva las variables creadas en el panel de Cloudflare (TIKTOK_CLIENT_KEY, etc.) en cada deploy.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
    // Solo estas rutas pasan por worker/index.js; el resto de la web se sirve directo.
    "run_worker_first": ["/api/*", "/panel/*"]
  },
  // Tokens de TikTok y registros de negocios. Sin "id": wrangler crea cada namespace solo en el primer deploy.
  "kv_namespaces": [{ "binding": "TIKTOK_KV" }, { "binding": "NEGOCIOS_KV" }],
  // Todos los días (09:17 UTC = 04:17 en Lima): renueva el token de TikTok y revisa el RUC de los negocios verificados.
  "triggers": { "crons": ["17 9 * * *"] },
  "observability": { "enabled": true }
}
