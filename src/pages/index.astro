  function say(text, ms) { popSay(text); clearTimeout(sayT); sayT = setTimeout(() => popSay(figShown ? figShown.say : ''), ms || 2600); }
  function figSection(sec) {
    const k = sec && sec.dataset.fig;
    figTarget = figActive() && k && FIG.poses[k] ? { key: (sec.id || 'pie') + ':' + k, pose: k, say: sec.dataset.say || '' } : null;
    if (figTarget) preloadFig();
    figStep();
  }
  // sale hacia arriba y se desvanece; parte de donde esté, aunque venga a medio salto
  const lift = () => figSwap.animate([{ opacity: 0, transform: 'translateY(-24px) scale(.97, 1.03)' }], { duration: 300, easing: 'cubic-bezier(.55, 0, .8, .2)', fill: 'forwards' });
  // cae desde arriba, se aplasta un poco al tocar el piso y se acomoda
  const drop = () => figSwap.animate([
    { opacity: 0, transform: 'translateY(-48px) scale(.97, 1.04)' },
    { opacity: 1, transform: 'translateY(0) scale(1.04, .95)', offset: .55 },
    { opacity: 1, transform: 'translateY(-5px) scale(.99, 1.01)', offset: .78 },
    { opacity: 1, transform: 'none' }
  ], { duration: 620, easing: 'cubic-bezier(.25, .8, .3, 1)', fill: 'forwards' });
  function figStep() {
    if (figBusy || keyOf(figTarget) === keyOf(figShown)) return;
    clearTimeout(sayT); figSay.classList.remove('show');
    if (figShown && !reduce) {
      figBusy = true; figShown = null; lift();
      setTimeout(() => { figBusy = false; figLand(figTarget); }, 420);
    } else figLand(figTarget);
  }
  function figLand(st) {
    figShown = st;
    if (!st) { if (reduce) figSwap.style.opacity = '0'; return; }
    const frames = FIG.poses[st.pose];
    figA.src = poseSrc(frames[0]); figB.src = poseSrc(frames[1] || frames[0]);
    fig.classList.toggle('tilt', !frames[1]);
    const shown = () => {
      if (figShown !== st) return;
      if (reduce) figSwap.style.opacity = '1'; else drop();
      setTimeout(() => {
        if (figShown !== st) return;
        if (!figGreeted) { figGreeted = true; say('Hola, soy Tato 👋', 2400); } else popSay(st.say);
      }, reduce ? 0 : 380);
    };
    Promise.all([figA, figB].map(im => (im.decode ? im.decode().catch(() => {}) : null))).then(shown);
  }
  // pasitos cuadro por cuadro: cambia de foto cada 110 px de scroll y trota mientras bajas
  function figScroll() {
    const y = scrollY; if (y === figLastY) return; figLastY = y;
    if (!figShown || reduce) return;
    fig.classList.toggle('alt', Math.floor(y / 110) % 2 === 1);
    bobStop = false;
    if (!fig.classList.contains('moving')) { bobN = 0; fig.classList.add('moving'); }
    clearTimeout(movingT); movingT = setTimeout(() => { bobStop = true; }, 160);
  }
  // el trote termina en el piso: solo se apaga al final de una bajada
  figBob.addEventListener('animationiteration', () => { bobN++; if (bobStop && bobN % 2 === 0) fig.classList.remove('moving'); });
  // se aparta del mouse y, si lo persigues, se queja
  let nearN = 0, nearT = 0, lastNag = -1e9, side = 0;
  // al apartarse a la derecha el globo se queda donde estaba (no se corta en pantallas angostas) y solo su punta sigue la cabeza
  const unDodge = () => { side = 0; fig.style.setProperty('--dx', '0px'); fig.style.setProperty('--dr', '0deg'); fig.style.setProperty('--sx', '0px'); };
  if (figReady && finePointer) addEventListener('pointermove', ev => {
    if (!figShown) { if (side) unDodge(); return; }
    const r = fig.getBoundingClientRect();
    const near = ev.clientX > r.left - 60 && ev.clientX < r.right + 60 && ev.clientY > r.top - 40 && ev.clientY < r.bottom;
    if (!near) { if (side) unDodge(); return; }
    const s = ev.clientX < r.left + r.width / 2 ? 1 : -1;
    if (s !== side) { side = s; if (!reduce) { fig.style.setProperty('--dx', s * 46 + 'px'); fig.style.setProperty('--dr', s * 3 + 'deg'); fig.style.setProperty('--sx', s > 0 ? '46px' : '0px'); } }
    nearN++; clearTimeout(nearT); nearT = setTimeout(() => { nearN = 0; }, 1400);
    const now = performance.now();
    if (nearN > 24 && now - lastNag > 6000) { lastNag = now; nearN = 0; say('¡Oe, tranquilo con el mouse! 😅', 2600); }
  }, { passive: true });
  if (figReady) { syncFigLayout(); figWide.addEventListener('change', syncFigLayout); }

  /* --- en celular y tablet: Tato dentro de cada sección, con su globo --- */
  if (figReady) {
    const mfigs = [];
    $$('[data-mfig]').forEach(sec => {
      const frames = FIG.poses[sec.dataset.fig]; if (!frames) return;
      const anchor = $('.lead', sec) || $('.row-head', sec) || $('h2', sec); if (!anchor) return;
      const box = document.createElement('div'); box.className = 'mfig'; box.setAttribute('aria-hidden', 'true');
      const p = document.createElement('p'); p.className = 'mfig__say'; setSay(p, sec.dataset.say);
      const im = document.createElement('img'); im.className = 'mfig__img'; im.alt = ''; im.loading = 'lazy'; im.decoding = 'async'; im.width = FIG.w; im.height = FIG.h; im.src = poseSrc(frames[0]);
      im.addEventListener('click', () => { if (reduce) return; box.classList.remove('wig'); void box.offsetWidth; box.classList.add('wig'); });
      box.append(p, im); anchor.after(box); mfigs.push(box);
    });
    if ('IntersectionObserver' in window && !reduce) {
      const mio = new IntersectionObserver(es => es.forEach(en => { if (en.isIntersecting) { en.target.classList.add('in'); mio.unobserve(en.target); } }), { threshold: .35 });
      mfigs.forEach(b => mio.observe(b));
    } else mfigs.forEach(b => b.classList.add('in'));
  }

  /* --- un solo bucle para el scroll --- */
  function render() { ticking = false; renderShot(); updateSections(); figScroll(); }
  function request() { if (!ticking) { ticking = true; requestAnimationFrame(render); } }
  addEventListener('scroll', request, { passive: true, capture: true });
  addEventListener('resize', () => { const s = pickSet(); if (set && s !== set) { frames.fill(undefined); loadedCount = 0; cv.classList.remove('ready'); loadFrames(); } resize(); syncFigLayout(); });
  if (!reduce) { const start = () => { loadFrames(); resize(); }; if (document.readyState === 'complete') start(); else addEventListener('load', start, { once: true }); }
  else addEventListener('load', () => setTimeout(preloadFig, 600), { once: true });
  setTimeout(preloadFig, 6000);
  request();

  /* --- videos y logo: se cargan cerca y se reproducen solo a la vista --- */
  const vids = $$('video[data-src]'), logos = $$('.logoanim');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver(es => es.forEach(en => {
      const el = en.target;
      if (el.classList.contains('logoanim')) { el.classList.toggle('play', en.isIntersecting && !reduce); return; }
      if (en.isIntersecting) { if (!el.src) { el.src = el.dataset.src; if (reduce) el.controls = true; } if (!reduce) { const pr = el.play(); if (pr && pr.catch) pr.catch(() => {}); } }
      else if (!el.paused) el.pause();
    }), { rootMargin: '200px 0px' });
    vids.forEach(v => io.observe(v)); logos.forEach(l => io.observe(l));
  } else vids.forEach(v => { v.src = v.dataset.src; });

  /* --- precios y pedido --- */
  const rows = $$('tr[data-id]'), sel = $('#f-prod');
  rows.forEach(r => { const o = document.createElement('option'); o.value = r.dataset.id; o.textContent = $('.pick', r).textContent + ' (' + r.dataset.price + ')'; sel.appendChild(o); });
  const pre = $('#preview-text'), send = $('#send'), permitRow = $('#permit-row'), permitText = $('#permit-text');
  function composed() {
    const r = rows.find(x => x.dataset.id === sel.value) || rows[0];
    const name = $('#f-name').value.trim(), city = $('#f-city').value, biz = $('#f-biz').value.trim(), msg = $('#f-msg').value.trim(), permit = $('#f-permit').checked;
    const kind = r.dataset.permit || '';
    permitRow.style.display = kind ? '' : 'none';
    permitText.textContent = kind === 'familia' ? 'La familia está de acuerdo con el homenaje.' : 'Tengo permiso de las personas que salen en las fotos.';
    let t = 'Hola Tato' + (name ? ', soy ' + name : '') + (city ? (name ? ', de ' : ', escribo de ') + city : '') + '.';
    t += '\nMe interesa: ' + $('.pick', r).textContent + ' (' + r.dataset.price + ').';
    if (biz) t += '\nEs para: ' + biz + '.';
    if (msg) t += '\n' + msg.replace(/\s+$/, '') + (/[.!?]$/.test(msg) ? '' : '.');
    if (kind && permit) t += '\n' + permitText.textContent;
    return t;
  }
  function refresh() { const t = composed(); pre.textContent = t + ref(); send.href = wa(t); rows.forEach(r => r.classList.toggle('is-picked', r.dataset.id === sel.value)); if (current && current.id === 'pedido') setBar(current); }
  ['#f-name', '#f-city', '#f-biz', '#f-msg', '#f-permit'].forEach(s => $(s).addEventListener('input', refresh)); sel.addEventListener('change', refresh);
  rows.forEach(r => r.addEventListener('click', () => { sel.value = r.dataset.id; refresh(); $('#order-form').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' }); }));
  $$('.card').forEach(c => { const id = c.id; if (rows.some(r => r.dataset.id === id)) c.addEventListener('dblclick', () => { sel.value = id; refresh(); }); });
  refresh();
  $('#copy').addEventListener('click', async () => {
    const b = $('#copy'), t = composed() + ref();
    try { await navigator.clipboard.writeText(t); b.textContent = 'Mensaje copiado'; }
    catch (e) { const rg = document.createRange(); rg.selectNodeContents(pre); const s = getSelection(); s.removeAllRanges(); s.addRange(rg); b.textContent = 'Selecciónalo y cópialo'; }
    setTimeout(() => { b.textContent = 'Copiar mensaje'; }, 2200);
  });

})();
</script>
</body>
</html>
