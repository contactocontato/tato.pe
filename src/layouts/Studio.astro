---
// Marco de las páginas de Tato Studio fuera de la portada (por ahora, /influencers/):
// cabecera con el logo sobre el fucsia, pie con foto y menú grande. Estilos en src/styles/studio.css.
import '../styles/studio.css';
import { site } from '../lib/site';

interface Props {
  title: string;
  description: string;
  image?: string;
  /** Qué link del menú va marcado. */
  actual?: 'influencers';
  /** Para páginas que no deben salir en Google, como el formulario de registro. */
  noindex?: boolean;
}
const { title, description, image = '/poster/transformacion.jpg', actual, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url);
const wa = `https://wa.me/${site.whatsappNumber}`;
import Medicion from '../components/Medicion.astro';
const menu = [
  { label: 'Influencers', href: '/influencers/' },
  { label: 'Precios', href: '/influencers/#precios' },
  { label: 'Preguntas', href: '/influencers/#preguntas' },
  { label: 'Soy influencer', href: '/influencers/unete/' },
  { label: 'Mi panel', href: '/negocio/' },
];
---
<!doctype html>
<html lang="es-PE">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
{noindex && <meta name="robots" content="noindex">}
<meta name="theme-color" content="#E2037E">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:image" content={new URL(image, canonical)}>
<meta property="og:type" content="website">
<meta property="og:locale" content="es_PE">
<meta name="twitter:card" content="summary_large_image">
<script is:inline>document.documentElement.classList.add('js')</script>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="sitemap" href="/sitemap-index.xml">
<link rel="preload" href="/fuentes/archivo-latin-wdth.woff2" as="font" type="font/woff2" crossorigin>
<meta name="generator" content={Astro.generator}>
</head>
<body>
<header class="top">
  <div class="wrap">
    <a class="brand" href="/"><img src="/inicio/logo-tato-cabecera.webp" width="180" height="180" alt="Tato Studio, ir al inicio"></a>
    <nav aria-label="Influencers">
      {menu.map((m) => <a href={m.href} aria-current={m.href === Astro.url.pathname ? 'page' : undefined}>{m.label}</a>)}
    </nav>
    <details class="menu">
      <summary>Menú</summary>
      <ul>{menu.map((m) => <li><a href={m.href}>{m.label}</a></li>)}<li><a href="/">Inicio de tato.pe</a></li></ul>
    </details>
  </div>
</header>

<main>
  <slot />
</main>

<footer>
  <div class="pie__foto"><img src="/inicio/seq/d/f_000.webp" width="720" height="1280" alt="Tato camina en su estudio, con su polo negro con el logo bordado" loading="lazy" decoding="async"></div>
  <div class="pie__menu">
    <p class="pie__marca">Tato Studio</p>
    <ul class="pie__nav">
      <li><a href="/influencers/#catalogo">Influencers</a></li>
      <li><a href="/influencers/#precios">Precios</a></li>
      <li><a href="/influencers/#preguntas">Preguntas</a></li>
      <li><a href="/influencers/registro/">Registra tu negocio</a></li>
      <li><a href="/influencers/unete/">Súmate como influencer</a></li>
      <li><a href="/">Inicio de tato.pe</a></li>
    </ul>
    <div class="pie__datos">
      <div><h2>Escríbeme</h2><ul><li><a href={wa} target="_blank" rel="noopener">WhatsApp +51 961 662 512</a></li><li><a href={`mailto:${site.email}`}>{site.email}</a></li><li><a href="/negocio/">Panel de mi negocio</a></li><li><a href="/cuenta/">Cuenta de influencer</a></li></ul></div>
      <div><h2>Sígueme</h2><ul><li><a href={site.tiktok} target="_blank" rel="noopener">TikTok</a></li><li><a href={site.instagram} target="_blank" rel="noopener">Instagram</a></li><li><a href={site.facebook} target="_blank" rel="noopener">Facebook</a></li><li><a href="/terminos/">Términos</a> · <a href="/privacidad/">Privacidad</a></li></ul></div>
    </div>
    <p class="pie__legal">Hecho en Huaraz, Perú. Los videos de los influencers están hechos con IA, con su permiso, y cada uno aprueba sus guiones.</p>
    <slot name="creditos" />
  </div>
</footer>
<script>
  // Cada sección entra una vez, cuando aparece en pantalla. Sin script, todo se ve igual.
  const vistos = document.querySelectorAll('[data-entra], .cartel, .cartel__h, .verbo');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entradas) => {
      for (const e of entradas) if (e.isIntersecting) { e.target.classList.add('ver'); io.unobserve(e.target); }
    }, { rootMargin: '0px 0px -12% 0px' });
    vistos.forEach((el) => io.observe(el));
  } else vistos.forEach((el) => el.classList.add('ver'));
</script>
<Medicion />
</body>
</html>
