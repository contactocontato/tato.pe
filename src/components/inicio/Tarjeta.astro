---
// Tarjeta de un servicio: foto o gráfico, precio, título, descripción y "Ver qué incluye" con el botón de WhatsApp.
import type { Servicio } from '../../data/inicio';
import { site } from '../../lib/site';
import { grafico } from './graficos';

interface Props { c: Servicio }
const { c } = Astro.props;
const m = c.media;
const waHref = `https://wa.me/${site.whatsappNumber}`;
---
<article class="card" id={c.id} data-short={c.title} data-wa={c.wa}>
  <div class="card__media">
    {m.type === 'img' && <img src={m.src} width="800" height="600" alt={m.alt} loading="lazy" decoding="async" />}
    {m.type === 'video' && <video muted loop playsinline preload="none" poster={m.poster} data-src={m.src} aria-label={m.alt}></video>}
    {(m.type === 'svg' || m.type === 'logo') && <Fragment set:html={grafico(m)} />}
  </div>
  <div class="card__body">
    <p class="card__price">{c.price}</p>
    <h3 class="card__title">{c.title}</h3>
    <p class="card__desc">{c.desc}</p>
    {c.meta && <p class="card__meta">{c.meta}</p>}
    <details class="card__more">
      <summary><span>Ver qué incluye</span><i aria-hidden="true"></i></summary>
      <div class="card__detail">
        <p class="label">Incluye</p>
        <ul>{c.incluye.map((x) => <li>{x}</li>)}</ul>
        {c.necesitas && <p class="label">Necesitas</p>}
        {c.necesitas && <p>{c.necesitas}</p>}
        {c.costo && <p class="label">Costo aparte al mes</p>}
        {c.costo && <p>{c.costo}</p>}
        {c.nota && <p class="card__note">{c.nota}{c.affiliate && <Fragment> <a class="link" href={site.higgsfield} target="_blank" rel="sponsored noopener">Entrar con mi link</a></Fragment>}</p>}
        {c.extraLink && <p><a class="link" data-wa={c.extraLink[1]} href={waHref} target="_blank" rel="noopener">{c.extraLink[0]}</a></p>}
        <a class="btn btn--fucsia btn--sm" data-wa={c.wa} href={waHref} target="_blank" rel="noopener">Pedir por WhatsApp</a>
      </div>
    </details>
  </div>
</article>
